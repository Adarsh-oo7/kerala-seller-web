# ============================================================
# Kerala Sellers Web — Environment Variables Template
# Copy to .env.local (Next.js reads .env.local automatically)
# NEVER commit .env or .env.local to git
# Set these same vars in Vercel dashboard for production
# ============================================================

# Backend API base URL
NEXT_PUBLIC_API_BASE_URL=https://api.keralasellers.in
NEXT_PUBLIC_API_URL=https://api.keralasellers.in

# Optional: Firebase web config (if using client-side Firebase)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
